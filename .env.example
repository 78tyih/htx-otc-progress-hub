# ============================================================================
# HTX OTC PIP 执行看板 — 环境变量模板（.env.example）
#
# 说明：
#   1. 本文件是【模板】，只含键名与占位值，可以安全提交到 git。
#   2. 真实的 .env 文件【不入 git】：请在项目根目录自行创建 .env，
#      并确认 .env 已加入 .gitignore，永不提交、永不推送。
#   3. 严禁把真实密码 / Token 写进前端代码、git 提交或聊天记录；
#      真实值只放平台环境变量（Vercel 后台）或本地 .env。
# 维护人：Sera ｜ 更新日期：2026-07-27
# ============================================================================

# --- Vercel KV（线上状态存储；Vercel 后台创建 KV 并连接项目后自动注入）---
# 未配置时：线上（VERCEL=1）所有写操作返回 503 KV_NOT_CONFIGURED，前端写入按钮禁用
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- 外部 Agent API 鉴权（推荐配置；不配则仅同源浏览器与本地开发可调用）---
# 配置后：无 Origin 的 curl/server-to-server 调用必须携带 Authorization: Bearer <token>
PIP_AGENT_API_TOKEN=
# 跨源白名单（逗号分隔，如 https://agent.example.com）；同源请求无需列入
PIP_ALLOWED_ORIGINS=
# 可选：限流阈值（次/分钟/IP，默认 60）
PIP_AGENT_RATE_LIMIT=
# 可选：请求体上限字节（默认 65536 = 64KB）
PIP_AGENT_MAX_BODY=

# --- 企业微信通知（Sera；服务端专用，不配则跳过该渠道）---
# 企微群机器人 webhook（群聊 → 群机器人 → 添加后复制，含 key，切勿提交真实值）
WECHAT_WEBHOOK_URL=

# --- 飞书通知（Simon；服务端专用，不配则跳过该渠道）---
# 飞书群机器人 webhook（飞书群 → 设置 → 群机器人 → 自定义机器人 → 复制）
FEISHU_WEBHOOK_URL=

# --- 通知卡片中的看板链接（必须是 Production 正式域名，禁止 localhost/局域网/Preview）---
# 不填则按请求域名自动推导
PIP_DASHBOARD_URL=

# --- AI 模型服务（可选；不配则 PIP 助手走纯本地对话解析，全部基础能力仍可用）---
# AI_* 优先；缺失时回退 LLM_*（向后兼容）
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 数据最小化策略，固定 minimal（只发送任务必要字段，永不发送 Token/Webhook/审计日志）
AI_DATA_POLICY=minimal
# 旧版变量（向后兼容，AI_* 优先）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ============================================================================
# 以下为 Vercel 部署平台自动注入，无需手动配置：
#   VERCEL              — 是否在 Vercel 环境
#   VERCEL_ENV          — deployment 环境（production/preview/development）
#   VERCEL_GIT_COMMIT_SHA     — 当前部署的 git commit SHA
#   VERCEL_GIT_COMMIT_MESSAGE — 当前部署的 git commit message
#   VERCEL_GIT_COMMIT_REF     — 当前部署的 git 分支名
# ============================================================================
